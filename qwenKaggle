    "    \"rejection_real_rate\": rejection_real_rate,\n",
    "    \"rejection_fake_rate\": rejection_fake_rate,\n",
    "    \"rejection_total_rate\": rejection_total_rate,\n",
    "    \"system_prompt\": systemPrompt,\n",
    "    \"user_prompt\": PROMPT\n",
    "}\n",
    "\n",
    "# Crea cartella se non esiste\n",
