    "    base_dir = Path(\"/kaggle/working/my_dataset\") / name\n",
    "    real_dir = base_dir / \"real\"\n",
    "    fake_dir = base_dir / \"fake\"\n",
    "\n",
    "    # Crea le directory se non esistono\n",
    "    real_dir.mkdir(parents=True, exist_ok=True)\n",
