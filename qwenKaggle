    "                print(\" TP (fake correctly identified)\")\n",
    "            elif prediction in {\"real face\", \"real\", \"[real face]\", \"agreed\", \"[real]\", \"[no]\", \"no\"}:\n",
    "                counters[\"fn\"] += 1\n",
    "                print(\" FN (fake misclassified as real)\")\n",
    "            else:\n",
