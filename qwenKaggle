    "    \"rejection_real\": counters[\"rejection_real\"],\n",
    "    \"rejection_fake\": counters[\"rejection_fake\"],\n",
    "    \"text_parsing_errors\": counters[\"er\"],\n",
    "    \"text_parsing_error_rate\": (counters[\"er\"] / len(images_with_labels)) if len(images_with_labels) else 0,\n",
